# ====================== 观澜 (GuanLan) 系统配置 ======================
# 运行时服务主机地址，例如：0.0.0.0 或 127.0.0.1
HOST=0.0.0.0
# 运行时服务端口号，默认为 3000 (REST API / SSE / Web 看板)
PORT=3000

# ====================== 数据库配置 ======================
# 数据库主机，例如 localhost 或 127.0.0.1
DB_HOST=your_db_host
# 数据库端口号，postgresql默认为5432，mysql默认为3306
DB_PORT=5432
# 数据库用户名
DB_USER=your_db_user
# 数据库密码
DB_PASSWORD=your_db_password
# 数据库名称
DB_NAME=your_db_name
# 数据库字符集，推荐 utf8mb4，兼容 emoji
DB_CHARSET=utf8mb4
# 数据库类型 mysql 或 postgresql
DB_DIALECT=postgresql

# ======================= LLM 模型配置 =======================
# 系统全面兼容 OpenAI 请求格式标准，配置 KEY、BASE_URL 与 MODEL_NAME 即可使用。
# 推荐优先使用通用配置，也可以针对各协同智能体单独指定模型。

# 通用 LLM 接口
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o

# 协同研判智能体配置（按需单独指定，留空则自动回退至通用配置）
# 主持研判智能体（HostAgent - 推荐深度思考与收敛能力较强的大模型，如 qwen-plus、deepseek-reasoner）
HOST_AGENT_API_KEY=
HOST_AGENT_BASE_URL=
HOST_AGENT_MODEL_NAME=qwen-plus

# 事实核查智能体（FactAgent - 推荐事实检索与证据链溯源模型）
FACT_AGENT_API_KEY=
FACT_AGENT_BASE_URL=
FACT_AGENT_MODEL_NAME=deepseek-chat

# 演化研判智能体（EvolutionAgent - 推荐时序推演与趋势建模模型）
EVOLUTION_AGENT_API_KEY=
EVOLUTION_AGENT_BASE_URL=
EVOLUTION_AGENT_MODEL_NAME=kimi-k2-0711-preview

# 情绪反馈智能体（FeedbackAgent - 推荐情感分析与群体画像洞察模型）
FEEDBACK_AGENT_API_KEY=
FEEDBACK_AGENT_BASE_URL=
FEEDBACK_AGENT_MODEL_NAME=gemini-2.5-pro

# MindSpider 爬虫辅助 LLM
MINDSPIDER_API_KEY=
MINDSPIDER_BASE_URL=
MINDSPIDER_MODEL_NAME=deepseek-chat

# ================== 网络与多模态搜索配置 ====================
# Tavily API 密钥，用于全网实时搜索（https://www.tavily.com/）
TAVILY_API_KEY=

# 网络搜索工具类型，支持 AnspireAPI 或 BochaAPI，默认为 AnspireAPI
SEARCH_TOOL_TYPE=AnspireAPI

# Anspire AI 搜索 API（https://open.anspire.cn/）
ANSPIRE_BASE_URL=https://plugin.anspire.cn/api/ntsearch/search
ANSPIRE_API_KEY=

# Bocha AI 搜索 API（https://open.bochaai.com/）
BOCHA_BASE_URL=https://api.bocha.cn/v1/ai-search
BOCHA_WEB_SEARCH_API_KEY=

# ================== TypeSafe Jev 情感分类引擎配置 ==================
# 官方控制台获取 API Key: https://docs.typesafe.ai/introduction/quickstart
TYPESAFE_API_KEY=
# Jev 服务地址（默认官方 endpoint: https://api.typesafe.ai/v1/systemone）
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
# Jev 模型版本别名（默认: jev-latest）
JEV_MODEL=jev-latest
# 分类置信度过滤阈值（默认: 0.60，低于此值或 insufficient 将归入 uncertain）
SENTIMENT_CONFIDENCE_THRESHOLD=0.60
# 并发请求限制（默认: 5）
SENTIMENT_CONCURRENCY=5
# 超时时间毫秒数（默认: 15000）
SENTIMENT_TIMEOUT_MS=15000